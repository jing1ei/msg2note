# Rust / Tauri build artifacts
/src-tauri/target/
**/*.rs.bk

# Regenerated by tauri-build on every compile — committing them means every
# build dirties the tree and every commit carries machine-generated churn.
/src-tauri/gen/

# `cargo tauri icon` emits a full cross-platform set. This app bundles macOS
# only (bundle.targets = app, dmg), so the mobile assets are dead weight.
/src-tauri/icons/android/
/src-tauri/icons/ios/
# Same reasoning: the Windows Store tile set is unused by a macOS-only bundle
# (tauri.conf.json's icon list never names them).
/src-tauri/icons/Square*Logo.png
/src-tauri/icons/StoreLogo.png

# Local runtime/config (these live in the OS app-config dir, but never commit
# them if a copy ends up in the tree — they can contain bot tokens / IDs).
bots.json
status.json
pending-*.json
*.corrupt-*
*.tmp
*.tmp-*

# macOS. No "Icon?" rule on purpose: with core.ignorecase=true it also matches
# src-tauri/icons/ and would exclude the committed icon set.
.DS_Store
.AppleDouble
.LSOverride

# The local Bot API server's data directory: downloaded attachments and its log.
# Normally outside the repo (next to bots.json), but same reasoning as above.
bot-api/

# Local double-click helper scripts. Personal convenience wrappers around
# `cargo tauri dev/build` and git — they live on disk, not in the repo.
/*.command

# Editor / IDE
.idea/
.vscode/
*.swp
*~

# Node (in case a frontend toolchain is added later)
node_modules/
dist/
